{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "blixis-docs#typecheck": {
      "dependsOn": ["blixis-docs#build"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#test": {
      "outputs": []
    },
    "//#test:coverage": {
      "outputs": ["coverage/**"]
    }
  }
}
