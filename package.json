{
  "name": "blixis-framework",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "format:check": "editorconfig-checker",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:fresh-install": "node scripts/fresh-install.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "turbo run build",
    "ci": "turbo run build && turbo run typecheck lint && pnpm run test:coverage && pnpm run format:check && pnpm run check:docs-links",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.2",
    "editorconfig-checker": "^7.0.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.25",
    "rolldown": "^1.2.11",
    "rolldown-plugin-dts": "^0.28.6",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
