{
  "name": "@blixis-io/http",
  "version": "0.1.0",
  "description": "The HTTP layer built on @blixis-io/core — routing, controllers, request validation with Zod, guards, RFC 9457 error responses.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/http"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["http", "framework", "rest", "typescript"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@blixis-io/core": "workspace:*",
    "@blixis-io/di": "workspace:*",
    "zod": "^4.6.5"
  }
}
