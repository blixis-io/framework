{
  "name": "@blixis-io/config",
  "version": "0.2.0",
  "description": "Zod-validated environment config, built on @blixis-io/core, HTTP-independent.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/config"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["config", "environment-variables", "zod", "typescript"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "peerDependencies": {
    "@blixis-io/core": "workspace:^",
    "@blixis-io/di": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@blixis-io/core": "workspace:*",
    "@blixis-io/di": "workspace:*",
    "zod": "^4.6.5"
  }
}
