{
  "name": "@blixis-io/core",
  "version": "0.4.1",
  "description": "The module system built on @blixis-io/di \u2014 @Module, lifecycle hooks, application bootstrapping.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["dependency-injection", "modules", "typescript", "framework"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "peerDependencies": {
    "@blixis-io/di": "workspace:^"
  },
  "devDependencies": {
    "@blixis-io/di": "workspace:*"
  }
}
