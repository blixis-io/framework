{
  "name": "@blixis-io/db",
  "version": "0.1.3",
  "description": "Drizzle-backed Postgres persistence, built on @blixis-io/core. Connects and disconnects via the same lifecycle hooks as everything else.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/db"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["postgres", "drizzle", "database", "typescript"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@blixis-io/core": "workspace:*",
    "@blixis-io/di": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6"
  }
}
