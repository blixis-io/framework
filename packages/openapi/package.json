{
  "name": "@blixis-io/openapi",
  "version": "0.3.0",
  "description": "Generates an OpenAPI 3.1 document from a running app's real controllers. Built on @blixis-io/http's decorator metadata; no serving mechanism or bundled UI of its own.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/openapi"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["openapi", "swagger", "api-documentation", "typescript"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "devDependencies": {
    "@blixis-io/core": "workspace:*",
    "@blixis-io/di": "workspace:*",
    "@blixis-io/http": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@blixis-io/di": "workspace:^",
    "@blixis-io/http": "workspace:^",
    "zod": "^4.6.5"
  }
}
