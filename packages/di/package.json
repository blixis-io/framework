{
  "name": "@blixis-io/di",
  "version": "0.1.0",
  "description": "A small, readable dependency injection container — @Injectable, @Inject, tokens, providers, singleton/transient scopes.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/di"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["dependency-injection", "ioc", "typescript", "decorators"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
