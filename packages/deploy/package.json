{
  "name": "@blixis-io/deploy",
  "version": "0.4.1",
  "description": "blix deploy: build and ship a Blixis app from your machine or a CI pipeline. Docker today; Vercel, Netlify and Cloudflare targets are planned.",
  "license": "MIT",
  "author": "Michael Voeten <michael@voeten.online>",
  "homepage": "https://blixis-io.github.io/framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/framework.git",
    "directory": "packages/deploy"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["deploy", "docker", "ci", "github-actions", "blix"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "@blixis-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rolldown -c"
  },
  "peerDependencies": {
    "@blixis-io/cli": "workspace:^"
  },
  "devDependencies": {
    "@blixis-io/cli": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
