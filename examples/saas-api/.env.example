# Copy to .env and fill in; the app reads the environment, nothing here is read from a file for you.
DATABASE_URL=postgres://blixis:blixis@localhost:5434/blixis
# At least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=
PORT=3000
# Origins a browser may call the API from, comma separated.
CORS_ORIGINS=http://localhost:5173
# How many reverse proxies you run in front of the server. 0 trusts no X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
